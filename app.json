{
  "expo": {
    "name": "Collab Créa",
    "slug": "collab-crea",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.collabcrea.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF5A36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.collabcrea.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "collabcrea",
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Collab Créa accède à tes photos pour ton profil, ton portfolio et tes contenus.",
          "cameraPermission": "Collab Créa utilise l'appareil photo pour la vérification d'identité et tes contenus.",
          "microphonePermission": "Collab Créa utilise le micro pour filmer tes contenus."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9AC65"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e5d3776-4c90-49bf-a1ab-af8a26e42ee5"
      }
    },
    "owner": "missdee"
  }
}
